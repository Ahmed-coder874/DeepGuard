# =============================================================================
# DeepGuard - Git ignore rules
# =============================================================================
# The trained checkpoint (models/deepguard_efficientnet_b0.pt) is intentionally
# NOT ignored: it is the authoritative, frozen model of this project and is
# committed with ordinary Git (16.3 MB, well under GitHub's 100 MB limit).
# =============================================================================


# -----------------------------------------------------------------------------
# Virtual environments (recreate them with: python -m venv venv)
# -----------------------------------------------------------------------------
venv/
venv-train/
venv*/
env/
ENV/
.venv/
.venv-train/
virtualenv/

# -----------------------------------------------------------------------------
# Dataset - NEVER committed
# -----------------------------------------------------------------------------
# data/faceforensics/ contains the original FaceForensics++ source videos.
# FaceForensics++ is a restricted, research-only dataset: it must not be
# redistributed through this repository.
# data/raw/ and data/processed/ contain the derived 600 experiment frames,
# which are reproduced deterministically by extract_dataset_frames.py and
# prepare_dataset.py (see data/README.md and docs/dataset_research.md).
# The Streamlit application does not need any of this to run inference.
data/*
!data/README.md

# -----------------------------------------------------------------------------
# Trained checkpoints other than the authoritative one
# -----------------------------------------------------------------------------
# models/deepguard_efficientnet_b0.pt is the single frozen official checkpoint
# and IS committed. Any other checkpoint produced by an ad-hoc run is ignored.
models/*
!models/deepguard_efficientnet_b0.pt
!models/.gitkeep

# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$pyclass
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache
nosetests.xml

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Secrets and local configuration - never commit
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc
.pypirc
credentials*
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
secrets.yml
secrets.yaml

# -----------------------------------------------------------------------------
# Logs, temporary files and local development artifacts
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~
*.stackdump
tmp/
temp/
.tmp/
scratch/

# Streamlit local runtime files
.streamlit/secrets.toml
.streamlit/config.local.toml

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# IDE / editor configuration and temporary files
